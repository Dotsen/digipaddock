[Unit]
Description=DigiPaddock: the sysadmin's problem monitor (checks the servers every 5 minutes)
After=network-online.target
Wants=network-online.target
# the monitor itself crashed or there is a 🔴 of the fallback path — a notification in the cabinet and a copy to
# Telegram (kd-alert reads the run's journal)
OnFailure=digipaddock-alert@digipaddock-monitor.service

[Service]
Type=oneshot
User=@base@
ExecStart=/usr/local/bin/kd-monitor tick
# waits for a running check by the button (deliver.tick_lock_wait — 290 s), then its own tick (up to ~290 s)
TimeoutStartSec=620
