#!/usr/bin/python3 -I
"""kd-repo-attach — the root unit that binds and unbinds a project's repository on the owner's request in the cabinet
: digipaddock-repo-attach.path starts it; the logic is dev_agent/repo_attach.py, the work is add_repo.sh's."""
import os
import sys

os.umask(0o022)  # add_repo.sh writes repos.json and projects.md 0644 itself
sys.stdout.reconfigure(encoding="utf-8", errors="replace")
sys.stderr.reconfigure(encoding="utf-8", errors="replace")
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from dev_agent.repo_attach import main  # noqa: E402

sys.exit(main())
