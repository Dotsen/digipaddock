#!/usr/bin/python3 -I
"""kd-deploys — the deploys reader: digipaddock-deploys.service under <prefix>-forge reads the projects' Forgejo
Actions runs into the cabinet; the logic is dev_agent/deploys.py."""

import os
import sys

os.umask(0o077)
sys.stdout.reconfigure(encoding="utf-8", errors="replace")
sys.stderr.reconfigure(encoding="utf-8", errors="replace")
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from dev_agent.deploys import main  # noqa: E402

sys.exit(main())
