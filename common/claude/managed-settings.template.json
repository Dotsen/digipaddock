{
  "promptSuggestionEnabled": false,
  "env": { "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false", "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1" },
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": ["@host:docs_dir@", "/var/log/digipaddock", "/srv/digipaddock-agents/board"],
    "ask": [],
    "deny": [
      "Bash(sudo *)", "Bash(su *)", "Monitor",
      "Read(//home/@base@/.claude/.credentials.json)",
      "Edit(//home/@base@/.claude/**)",
      "Edit(//home/@base@/.claude.json)",
      "Edit(//home/@base@/.ssh/**)",
      "Edit(//home/@base@/.local/**)",
      "Edit(//home/@base@/.bun/**)",
      "Edit(//home/@base@/.config/**)",
      "Edit(//home/@base@/.bashrc)",
      "Edit(//home/@base@/.profile)",
      "Edit(//home/@base@/.bash_profile)",
      "Read(//home/@base@/.ssh/**)",
      "Read(//home/@exec@/**)",
      "Read(//etc/@exec@/**)",
      "Read(//var/www/**/config.ini)",
      "Read(//var/www/**/.env)",
      "Edit(//srv/digipaddock-agents/board/**)",
      "Read(//etc/digipaddock/pult.env)",
      "Read(//etc/digipaddock/claude.env)",
      "Read(//etc/digipaddock/llm/**)",
      "Read(//etc/digipaddock/forge/**)",
      "Read(//home/@forge@/**)",
      "Read(//home/@base@/.hindsight/**)",
      "Edit(//home/@base@/.hindsight/**)",
      "Read(//etc/hindsight/**)",
      "Edit(//var/lib/digipaddock/**)",
      "Read(//home/@agent:dev@/.claude/.credentials.json)",
      "Edit(//home/@agent:dev@/.claude/**)",
      "Edit(//home/@agent:dev@/.claude.json)",
      "Edit(//home/@agent:dev@/.ssh/**)",
      "Edit(//home/@agent:dev@/.local/**)",
      "Edit(//home/@agent:dev@/.bun/**)",
      "Edit(//home/@agent:dev@/.config/**)",
      "Edit(//home/@agent:dev@/.bashrc)",
      "Edit(//home/@agent:dev@/.profile)",
      "Edit(//home/@agent:dev@/.bash_profile)",
      "Read(//home/@agent:dev@/.ssh/**)",
      "Read(//home/@agent:dev@/.hindsight/**)",
      "Edit(//home/@agent:dev@/.hindsight/**)",
      "Read(//home/@agent:boss@/.claude/.credentials.json)",
      "Edit(//home/@agent:boss@/.claude/**)",
      "Edit(//home/@agent:boss@/.claude.json)",
      "Edit(//home/@agent:boss@/.ssh/**)",
      "Edit(//home/@agent:boss@/.local/**)",
      "Edit(//home/@agent:boss@/.bun/**)",
      "Edit(//home/@agent:boss@/.config/**)",
      "Edit(//home/@agent:boss@/.bashrc)",
      "Edit(//home/@agent:boss@/.profile)",
      "Edit(//home/@agent:boss@/.bash_profile)",
      "Read(//home/@agent:boss@/.ssh/**)",
      "Read(//home/@agent:boss@/.hindsight/**)",
      "Edit(//home/@agent:boss@/.hindsight/**)",
      "Read(//home/@agent:sysadmin@/.claude/.credentials.json)",
      "Edit(//home/@agent:sysadmin@/.claude/**)",
      "Edit(//home/@agent:sysadmin@/.claude.json)",
      "Edit(//home/@agent:sysadmin@/.ssh/**)",
      "Edit(//home/@agent:sysadmin@/.local/**)",
      "Edit(//home/@agent:sysadmin@/.bun/**)",
      "Edit(//home/@agent:sysadmin@/.config/**)",
      "Edit(//home/@agent:sysadmin@/.bashrc)",
      "Edit(//home/@agent:sysadmin@/.profile)",
      "Edit(//home/@agent:sysadmin@/.bash_profile)",
      "Read(//home/@agent:sysadmin@/.ssh/**)",
      "Read(//home/@agent:sysadmin@/.hindsight/**)",
      "Edit(//home/@agent:sysadmin@/.hindsight/**)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/digipaddock/common/bin/kd-permlog", "timeout": 5 }
        ]
      }
    ]
  }
}
