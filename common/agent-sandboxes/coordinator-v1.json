{
  "schema_version": 1,
  "name": "coordinator-v1",
  "description": "Fail-closed sandbox for a coordinator: no network, Unix sockets only to its own channels, no local binding, writes only in its working directory; its board and nudge tools reach their channels, nothing is excluded from the sandbox.",
  "settings": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "credentials": {"envVars": [{"name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny"}, {"name": "ANTHROPIC_AUTH_TOKEN", "mode": "deny"}, {"name": "ANTHROPIC_API_KEY", "mode": "deny"}]},
    "network": {
      "strictAllowlist": true,
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    }
  },
  "ceiling": {
    "network_domains": [],
    "channel_commands": ["kd-boss-board", "kd-data", "kd-host-read", "kd-monitor-read", "kd-notes", "kd-nudge", "kd-task", "kd-worker"],
    "writable": ["work"]
  }
}
