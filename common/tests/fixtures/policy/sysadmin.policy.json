      "user": "digi-sysadmin"
    },
    {
      "access": "read",
      "path": "/var/log/digipaddock",
      "resource": "exec-journal",
      "user": "digi-sysadmin"
    },
    {
      "access": "read",
      "path": "/srv/digipaddock-repos",
      "resource": "repo-checkouts",
      "user": "digi-sysadmin"
    }
