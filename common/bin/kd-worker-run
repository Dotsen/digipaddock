#!/usr/bin/python3 -I
"""kd-worker-run --slot <agent>/workerN — one worker job of the session host (root): the job's
definition on stdin, its end line on stdout (kd.worker_runner.main)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from kd import worker_runner  # noqa: E402

if __name__ == "__main__":
    if os.geteuid() != 0:
        print(
            "kd-worker-run: runs as root in the session host's job unit", file=sys.stderr
        )
        sys.exit(2)
    os.environ.clear()
    os.environ.update(PATH="/usr/bin:/bin", LANG="C.UTF-8", HOME="/root")
    os.chdir("/")
    os.umask(0o077)
    sys.exit(worker_runner.main(sys.argv[1:]))
