#!/usr/bin/python3 -I
"""One voice message on stdin → one JSON line on stdout (kd/transcribe.py); run by the transcription
venv's python, one process per connection of the socket unit."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from kd import transcribe  # noqa: E402

if os.geteuid() == 0:
    sys.exit("kd-transcribe: never runs as root")
sys.exit(transcribe.main())
