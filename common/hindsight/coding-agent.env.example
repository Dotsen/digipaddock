# /etc/hindsight/coding-agent.env — root:root 0600. Секреты только здесь: @db_password@ и @tenant_key@ подставляет
# hindsight_setup.sh install (openssl rand), когда этого файла ещё нет.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:@db_password@@127.0.0.1:5432/hindsight?sslmode=disable
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=9077
HINDSIGHT_API_WORKER_ENABLED=false
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=@tenant_key@
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_LLM_PROVIDER=claude-code
HINDSIGHT_API_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_RETAIN_LLM_PROVIDER=claude-code
HINDSIGHT_API_RETAIN_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_REFLECT_LLM_PROVIDER=claude-code
HINDSIGHT_API_REFLECT_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER=claude-code
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_DB_SESSION_SETUP_ON_ACQUIRE=false
HF_HUB_OFFLINE=1
# A knowledge page's refresh waits for one of the two LLM slots above behind consolidation and takes 2-4 minutes on
# its own: at the default 300 s most refreshes were cancelled, and a cancelled one pauses the page's schedule.
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=900
# The bank operations of the cabinet's Hindsight page (/audit-logs/stats); kept 90 days.
HINDSIGHT_API_AUDIT_LOG_ENABLED=true
HINDSIGHT_API_AUDIT_LOG_RETENTION_DAYS=90
# The server's own LLM calls (llm_requests, tokens per operation) for a whole week, not the default one day.
HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=8
