{
  "schema_version": 1,
  "layout": {
    "agents": "/srv/digipaddock-agents",
    "code": "/opt/digipaddock"
  },
  "resources": {
    "e2e-runtime": {"kind": "dir", "path": "/var/lib/digipaddock/e2e/runtime", "secret": false},
    "admin-grants": {"kind": "dir", "path": "/var/lib/digipaddock/admin-grants", "secret": false},
    "admin-proposals": {"kind": "dir", "path": "/var/lib/digipaddock/admin-proposals", "secret": false},
    "agent-registry": {"kind": "file", "path": "/etc/digipaddock/agents.json", "secret": false},
    "board-attention": {"kind": "dir", "path": "/var/lib/digipaddock/attention", "secret": false},
    "board-activity": {"kind": "file", "path": "/var/log/digipaddock-board/activity.jsonl", "secret": false},
    "board-attention-acks": {"kind": "file", "path": "/var/log/digipaddock-board/attention-ack.jsonl", "secret": false},
    "board-directives": {"kind": "file", "path": "/var/log/digipaddock-board/directives.json", "secret": false},
    "board-audit": {"kind": "file", "path": "/var/log/digipaddock-board/boss.jsonl", "secret": false},
    "board-tasks": {"kind": "dir", "path": "/srv/digipaddock-agents/board", "secret": false},
    "egress-config": {"kind": "file", "path": "/opt/digipaddock/host/egress.json", "secret": false},
    "diagnostics-catalog": {"kind": "file", "path": "/opt/digipaddock/common/coordination/diagnostics.json", "secret": false},
    "host-read-catalog": {"kind": "file", "path": "/opt/digipaddock/common/coordination/host-read.json", "secret": false},
    "factory-catalog": {"kind": "file", "path": "/opt/digipaddock/common/coordination/factory.json", "secret": false},
    "boss-delegation": {"kind": "file", "path": "/var/log/digipaddock-board/delegation.jsonl", "secret": false},
    "boss-grants": {"kind": "dir", "path": "/var/lib/digipaddock/boss-promotions/grants", "secret": false},
    "worker-jobs": {"kind": "dir", "path": "/var/lib/digipaddock/worker", "secret": false},
    "exec-journal": {"kind": "dir", "path": "/var/log/digipaddock", "secret": false},
    "exec-key": {"kind": "file", "path": "/home/@exec@/.ssh/agent_exec_ed25519", "secret": true},
    "forge-journal": {"kind": "dir", "path": "/var/log/digipaddock-forge", "secret": false},
    "forge-repos": {"kind": "file", "path": "/etc/digipaddock/repos.json", "secret": false},
    "forge-ssh-key": {"kind": "file", "home": [".ssh/config", ".ssh/{agent}_ed25519"], "secret": true},
    "forge-tokens": {"kind": "dir", "path": "/etc/digipaddock/forge", "secret": true},
    "project-docs": {"kind": "dir", "path": "@host:docs_dir@", "secret": false},
    "monitor-state": {"kind": "dir", "path": "/var/lib/digipaddock/monitor", "secret": false},
    "release-requests": {"kind": "dir", "path": "/var/lib/digipaddock/release", "secret": false},
    "code-mirror": {"kind": "dir", "path": "/srv/digipaddock-mirror", "secret": false},
    "repo-checkouts": {"kind": "dir", "path": "/srv/digipaddock-repos", "secret": false},
    "server-inventory": {"kind": "file", "path": "/opt/digipaddock/agents/sysadmin/inventory.json", "secret": false},
    "server-ro-key": {"kind": "file", "home": [".ssh/agent_ro_ed25519"], "secret": true},
    "servers-enabled": {"kind": "file", "path": "/etc/digipaddock/servers.enabled", "secret": false},
    "usage-ledger": {"kind": "file", "path": "/var/lib/digipaddock/usage.jsonl", "secret": false}
  },
  "protected": [
    {"kind": "dir", "path": "/etc/hindsight", "deny": ["read"]},
    {"kind": "dir", "path": "/etc/@exec@", "deny": ["read"]},
    {"kind": "file", "path": "/etc/digipaddock/cabinet.env", "deny": ["read"]},
    {"kind": "file", "path": "/etc/digipaddock/pult.env", "deny": ["read"]},
    {"kind": "file", "path": "/etc/digipaddock/claude.env", "deny": ["read"]},
    {"kind": "dir", "path": "/etc/digipaddock/llm", "deny": ["read"]},
    {"kind": "file", "path": "/etc/digipaddock/push.env", "deny": ["read"]},
    {"kind": "dir", "path": "/etc/digipaddock/review", "deny": ["read"]},
    {"kind": "pattern", "path": "/opt/**/.git/config", "deny": ["read"]},
    {"kind": "pattern", "path": "/opt/**/vpn/*.conf", "deny": ["read"]},
    {"kind": "dir", "path": "/var/lib/digipaddock", "deny": ["edit", "read"]},
    {"kind": "pattern", "path": "/var/www/**/.env", "deny": ["read"]},
    {"kind": "pattern", "path": "/var/www/**/.env.*", "deny": ["read"]},
    {"kind": "pattern", "path": "/var/www/**/.git/config", "deny": ["read"]},
    {"kind": "pattern", "path": "/var/www/**/config.ini", "deny": ["read"]},
    {"kind": "pattern", "path": "/var/www/**/config.ini*", "deny": ["read"]},
    {"kind": "dir", "path": "@host:docs_dir@", "deny": ["edit"]}
  ]
}
