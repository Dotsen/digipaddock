{
  "name": "cabinet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The owner cabinet's PWA (KD-226): Svelte 5, Vite, TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "screenshots": "vite build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.0",
    "jsdom": "30.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@mermaid-js/tiny": "12.2.0",
    "dompurify": "3.4.17",
    "marked": "18.0.14"
  }
}
