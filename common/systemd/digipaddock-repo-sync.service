[Unit]
Description=DigiPaddock: updating the read-only repository copies for repo.read
OnFailure=digipaddock-alert@digipaddock-repo-sync.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@repo@
Group=@repo@
# The service user alone holds the read-only deploy key (~/.ssh/repo_sync_ed25519); agents read the result by ACL.
Environment=HOME=/home/@repo@ LANG=C.UTF-8 PATH=/usr/bin:/bin
UMask=0027
ExecStart=/usr/local/bin/kd-repo-sync
TimeoutStartSec=600
ProtectSystem=strict
ReadWritePaths=/srv/digipaddock-repos
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
