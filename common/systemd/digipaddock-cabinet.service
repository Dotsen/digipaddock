[Unit]
Description=DigiPaddock: the owner cabinet — board, web and decisions; the only process that opens cabinet.db
Requires=digipaddock-cabinet.socket
After=digipaddock-cabinet.socket
OnFailure=digipaddock-alert@digipaddock-cabinet.service

[Service]
User=@cabinet@
# The group is the socket's: systemd re-owns RuntimeDirectory recursively to User:Group at every start, the
# socket file inside included, so the service's group must be the one the socket unit grants (digipaddock-cabinet).
# The base and the stamp are the service's alone: UMask 0077 (the group gets nothing on cabinet.db).
Group=digipaddock-cabinet
# The user's own group: the sysadmin's plans (admin-proposals, <agent>:<cabinet> 2750) reach the cabinet alone.
SupplementaryGroups=@cabinet@
# Both sockets by name (local: agents and executors, http: nginx). The http one is not required: until
# cabinet.json and cabinet.env exist the service serves the board alone (cabinet_setup.sh installs both).
Sockets=digipaddock-cabinet.socket digipaddock-cabinet-http.socket
ExecStart=/var/lib/digipaddock/venv/cabinet/bin/python3 -I /opt/digipaddock/common/bin/kd-cabinet serve
Restart=always
RestartSec=2
# /run/digipaddock-cabinet holds the socket too: the directory stays when the service stops
RuntimeDirectory=digipaddock-cabinet
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
Environment=HOME=/nonexistent LANG=C.UTF-8 PATH=/usr/bin:/bin
# Writes its base (with backups and files) and the change stamp; the owner's decisions write the sysadmin's grants
# (only with the sysadmin's module), the BOSS promote decisions and delegation grants, and append to the BOSS audit
# journal (ACL). "-": a store not made yet fails its decision, never the board. Reads the code,
# agents.json, cabinet.json/env and the proposals (the board's projects are its base's table).
ProtectSystem=strict
ReadWritePaths=/var/lib/digipaddock/cabinet
ReadWritePaths=-/var/lib/digipaddock/admin-grants
ReadWritePaths=-/var/lib/digipaddock/boss-promotions/decisions -/var/lib/digipaddock/boss-promotions/grants
ReadWritePaths=-/var/log/digipaddock-board
# The session host's socket (the dispatcher sends commands there; root:<cabinet> 0660).
ReadWritePaths=-/run/digipaddock-session-host
# kd-review's socket (the PR approval goes there; root:<cabinet> 0660).
ReadWritePaths=-/run/digipaddock-review
# Owner-signed provider key writes; the files and signer registry remain unreadable.
ReadWritePaths=-/run/digipaddock-model-keys
LimitCORE=0
# kd-transcribe's socket (one voice message per connection; root:<cabinet> 0660).
ReadWritePaths=-/run/digipaddock-transcribe
# The doorbell of the root unit kd-repo-attach (a repository request; root:<cabinet> 0770, made by
# repo_attach_setup.sh; "-": not installed yet — the requests wait in the base).
ReadWritePaths=-/var/lib/digipaddock/repo-attach
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=512M
